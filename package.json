{
  "name": "ue-settings-master",
  "private": true,
  "version": "1.5.4",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:serve": "cross-env GSM_E2E=1 vite --mode e2e",
    "types:gen": "cargo test export_typescript_bindings --manifest-path src-tauri/Cargo.toml -- --nocapture",
    "catalog:build": "python tools/ue-catalog-builder/fixtures/gen_fixtures.py && python tools/ue-catalog-builder/build.py",
    "catalog:test": "python tools/ue-catalog-builder/test_build.py",
    "catalog:gaps": "python tools/ue-catalog-builder/analysis/catalog_gaps.py",
    "validation:index": "node scripts/generate-validation-index.mjs",
    "validation:index:check": "node scripts/verify-validation-index.mjs",
    "i18n:parity": "node scripts/verify-i18n-parity.mjs",
    "tauri:versions:check": "node scripts/verify-tauri-versions.mjs",
    "tauri": "tauri",
    "icons": "npm run generate --prefix brand",
    "landing:build": "npm run build --prefix landing",
    "landing:dev": "npm run dev --prefix landing",
    "landing:capture": "npm run capture-screenshots --prefix landing",
    "screenshots:readme": "node scripts/capture-readme-screenshots.mjs",
    "updater:keys": "powershell -ExecutionPolicy Bypass -File scripts/open-keygen-terminal.ps1",
    "updater:sync-pubkey": "powershell -ExecutionPolicy Bypass -File scripts/sync-updater-pubkey.ps1",
    "updater:build": "powershell -ExecutionPolicy Bypass -File scripts/build-signed.ps1"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-virtual": "^3.14.24",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "i18next": "^26.5.11",
    "i18next-browser-languagedetector": "^8.2.3",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^10.1.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.0.5"
  }
}
